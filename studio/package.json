{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:all": "concurrently -k -n web,worker \"next dev -H 127.0.0.1 -p 3000\" \"tsx watch worker/start.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start -H 127.0.0.1 -p 3000\" \"tsx worker/start.ts\"",
    "worker": "tsx worker/start.ts",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:serve": "rm -rf data/e2e.db* data/e2e-videos && AGENT=fake FAKE_DELAY_MS=150 DB_PATH=$PWD/data/e2e.db VIDEOS_DIR=$PWD/data/e2e-videos concurrently -k \"next dev -H 127.0.0.1 -p 3100\" \"tsx worker/start.ts\"",
    "lint": "eslint"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
